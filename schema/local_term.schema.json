{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Celebridge/haoliang/schema/local_term.schema.json",
  "title": "Haoliang Local Term",
  "type": "object",
  "required": [
    "id",
    "kind",
    "term",
    "scope",
    "project",
    "definition",
    "source",
    "status",
    "sensitivity"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^g_[0-9]{4,6}$" },
    "kind": { "const": "local-term" },
    "term": { "type": "string", "minLength": 1 },
    "scope": { "enum": ["project", "model"] },
    "project": { "type": "string", "minLength": 1 },
    "definition": { "type": "string" },
    "reason": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "source": { "type": "string" },
    "first_seen": { "type": "string" },
    "last_seen": { "type": "string" },
    "expires_at": { "type": ["string", "null"] },
    "status": { "enum": ["active", "archived"] },
    "sensitivity": { "enum": ["private", "sensitive"] },
    "created_at": { "type": ["string", "null"] },
    "updated_at": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
