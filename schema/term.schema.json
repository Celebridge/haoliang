{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Celebridge/haoliang/schema/term.schema.json",
  "title": "Haoliang Term Card",
  "type": "object",
  "required": [
    "id",
    "kind",
    "term",
    "domain",
    "evidence",
    "status",
    "author",
    "sensitivity"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^t_[0-9]{4,6}$" },
    "kind": { "const": "term" },
    "term": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 1 },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "domains": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "weight", "time"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "minimum": -1, "maximum": 1 },
          "time": { "type": "string", "minLength": 1 },
          "source": { "type": "string" },
          "quote": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "stability_days": { "type": "number", "minimum": 0.5 },
    "last_evidence_at": { "type": ["string", "null"] },
    "merged_into": {
      "type": ["string", "null"],
      "pattern": "^t_[0-9]{4,6}$"
    },
    "superseded_by": {
      "type": ["string", "null"],
      "pattern": "^t_[0-9]{4,6}$"
    },
    "archived_at": { "type": ["string", "null"] },
    "archive_reason": { "type": ["string", "null"] },
    "last_used_at": { "type": ["string", "null"] },
    "pending_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["time", "source", "domain", "reason"],
        "properties": {
          "time": { "type": "string", "minLength": 1 },
          "source": { "type": "string" },
          "domain": { "type": "string", "minLength": 1 },
          "reason": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "status": { "enum": ["proposal", "canon", "archived"] },
    "author": { "enum": ["player", "ai-proposed", "imported"] },
    "sensitivity": { "enum": ["private", "sensitive"] },
    "created_at": { "type": ["string", "null"] },
    "updated_at": { "type": ["string", "null"] },
    "confirmed_at": { "type": ["string", "null"] }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "canon" } }
      },
      "then": {
        "properties": { "evidence": { "minItems": 1 } }
      }
    }
  ]
}
