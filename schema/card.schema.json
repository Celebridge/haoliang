{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Celebridge/Haoliang/schema/card.schema.json",
  "title": "Haoliang Card",
  "type": "object",
  "required": ["id", "section", "type", "title", "summary", "status", "sensitivity", "source"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z][0-9]+$" },
    "section": { "type": "string", "pattern": "^[A-Z]$" },
    "section_title": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["fact", "event", "preference", "relationship", "value", "goal", "trait", "instruction", "exercise"]
    },
    "thread": { "type": "string" },
    "title": { "type": "string" },
    "question": { "type": "string" },
    "summary": { "type": "string" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "time": { "type": ["string", "null"] },
          "confidence": { "type": ["string", "null"] }
        }
      }
    },
    "text": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "entities": { "type": "array", "items": { "type": "string" } },
    "time": {
      "type": ["object", "null"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": ["string", "null"] },
        "precision": { "type": "string" }
      }
    },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "sensitivity": { "type": "string", "enum": ["private", "sensitive"] },
    "status": { "type": "string", "enum": ["answered", "skipped", "uncertain"] },
    "importance": { "type": "integer", "minimum": 0, "maximum": 3 },
    "links": {
      "type": "object",
      "properties": {
        "supersedes": { "type": ["string", "null"] },
        "contradicts": { "type": "array", "items": { "type": "string" } },
        "related": { "type": "array", "items": { "type": "string" } },
        "part_of": { "type": "array", "items": { "type": "string" } }
      }
    },
    "source": {
      "type": "object",
      "required": ["file", "question_id"],
      "properties": {
        "file": { "type": "string" },
        "question_id": { "type": "string" },
        "exported_at": { "type": ["string", "null"] }
      }
    },
    "updated_at": { "type": ["string", "null"] }
  }
}
