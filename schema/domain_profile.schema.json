{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Celebridge/haoliang/schema/domain_profile.schema.json",
  "title": "Haoliang Domain Profile",
  "type": "object",
  "required": ["domain", "knowledge", "confidence", "source"],
  "properties": {
    "domain": { "type": "string", "minLength": 1 },
    "label": { "type": "string" },
    "knowledge": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "terms": { "type": "integer", "minimum": 0 },
    "source": { "enum": ["derived", "self_report", "quiz", "mixed"] },
    "updated_at": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
